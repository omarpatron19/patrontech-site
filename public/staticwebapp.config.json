{
  "routes": [
    {
      "route": "/index.html",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/articulos.html",
      "redirect": "/articulos/",
      "statusCode": 301
    },
    {
      "route": "/guias.html",
      "redirect": "/guias/",
      "statusCode": 301
    },
    {
      "route": "/novedades.html",
      "redirect": "/novedades/",
      "statusCode": 301
    },
    {
      "route": "/recursos.html",
      "redirect": "/recursos/",
      "statusCode": 301
    },
    {
      "route": "/categorias.html",
      "redirect": "/categorias/",
      "statusCode": 301
    },
    {
      "route": "/sobre-mi.html",
      "redirect": "/sobre-mi/",
      "statusCode": 301
    },
    {
      "route": "/sitemap.xml",
      "redirect": "/sitemap-index.xml",
      "statusCode": 301
    },
    {
      "route": "/_astro/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "Content-Security-Policy-Report-Only": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".webmanifest": "application/manifest+json",
    ".webp": "image/webp",
    ".avif": "image/avif"
  }
}
