---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildCollectionPageJsonLd } from '../lib/seo';
import {
  certifications,
  providers,
  routes,
  transitions,
  officialSources,
  providerNotes
} from '../data/certifications';

const defaultProvider = 'Microsoft';
const providerAreas = Object.fromEntries(
  providers.map((provider) => [
    provider,
    ['Todos', ...new Set(
      certifications
        .filter((item) => item.provider === provider)
        .map((item) => item.area)
    )]
  ])
);

const providerCounts = Object.fromEntries(
  providers.map((provider) => [
    provider,
    certifications.filter((item) => item.provider === provider).length
  ])
);

const structuredData = buildCollectionPageJsonLd(
  'Mapa de certificaciones Cloud 2026 | Microsoft, AWS y Google Cloud | PatronTech',
  'Explora certificaciones vigentes, rutas profesionales y cambios de Microsoft, AWS y Google Cloud con referencias a la documentación oficial.',
  '/certificaciones/'
);
---

<BaseLayout
  title="Mapa de certificaciones Cloud 2026 | Microsoft, AWS y Google Cloud | PatronTech"
  description="Mapa multicloud actualizado de certificaciones Microsoft, AWS y Google Cloud: rutas, niveles, vigencia, cambios anunciados y documentación oficial."
  canonicalPath="/certificaciones/"
  structuredData={structuredData}
>
  <section class="page-hero certification-hero">
    <div class="container">
      <span class="eyebrow">Cloud certifications · revisado 14 agosto 2026</span>
      <h1>Mapa de certificaciones Cloud</h1>
      <p>
        Compara las rutas vigentes de <strong>Microsoft, AWS y Google Cloud</strong>.
        El mapa está pensado para ayudarte a elegir una ruta por rol, detectar certificaciones
        próximas a retirarse y evitar estudiar con diagramas desactualizados.
      </p>

      <div class="provider-summary" aria-label="Resumen de proveedores">
        <button class="provider-summary-card active" type="button" data-provider-filter="Microsoft">
          <span class="provider-kicker">Microsoft</span>
          <strong>{providerCounts['Microsoft']}</strong>
          <small>credenciales técnicas mapeadas</small>
        </button>
        <button class="provider-summary-card" type="button" data-provider-filter="AWS">
          <span class="provider-kicker">AWS</span>
          <strong>{providerCounts['AWS']}</strong>
          <small>certificaciones técnicas vigentes/transición</small>
        </button>
        <button class="provider-summary-card" type="button" data-provider-filter="Google Cloud">
          <span class="provider-kicker">Google Cloud</span>
          <strong>{providerCounts['Google Cloud']}</strong>
          <small>certificaciones del catálogo vigente</small>
        </button>
      </div>

      <p class="cert-disclaimer">
        PatronTech muestra rutas sugeridas para facilitar la navegación. Antes de comprar o
        programar un examen, valida siempre requisitos, idioma, versión y fecha de retiro en
        la documentación oficial del proveedor.
      </p>
    </div>
  </section>

  <section class="section provider-nav-section">
    <div class="container">
      <div class="provider-tabs" role="group" aria-label="Seleccionar proveedor cloud">
        {providers.map((provider) => (
          <button
            type="button"
            class:list={{ 'provider-tab': true, active: provider === defaultProvider }}
            data-provider-filter={provider}
          >
            {provider}
          </button>
        ))}
      </div>

      {providers.map((provider) => (
        <p
          class="provider-note"
          data-provider-note={provider}
          hidden={provider !== defaultProvider}
        >
          {providerNotes[provider]}
        </p>
      ))}
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Rutas sugeridas</span>
          <h2>¿Por dónde empezar?</h2>
          <p>
            Las secuencias son recomendaciones editoriales. Cuando un proveedor exige
            prerequisites formales, se indica en la tarjeta correspondiente.
          </p>
        </div>
      </div>

      {providers.map((provider) => (
        <div
          class="path-grid"
          data-provider-routes={provider}
          hidden={provider !== defaultProvider}
        >
          {routes.filter((route) => route.provider === provider).map((route) => (
            <article class="path-card">
              <span class="route-provider">{provider}</span>
              <h3>{route.title}</h3>
              <div class="path-flow">
                {route.steps.map((step, index) => (
                  <>
                    <span>{step}</span>
                    {index < route.steps.length - 1 && <b>→</b>}
                  </>
                ))}
              </div>
              <p>{route.description}</p>
            </article>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section class="section" data-cert-shell>
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Explorar credenciales</span>
          <h2>Certificaciones por proveedor y especialidad</h2>
          <p>Selecciona un proveedor, filtra por área o busca por examen, rol o tecnología.</p>
        </div>
      </div>

      <div class="cert-toolbar">
        <div class="area-filter-shell">
          {providers.map((provider) => (
            <div
              class="filter-row"
              data-area-group={provider}
              hidden={provider !== defaultProvider}
              role="group"
              aria-label={`Filtrar certificaciones de ${provider}`}
            >
              {providerAreas[provider].map((area) => (
                <button
                  type="button"
                  class:list={{ 'filter-btn': true, active: area === 'Todos' }}
                  data-area-filter={area}
                  data-area-provider={provider}
                >
                  {area}
                </button>
              ))}
            </div>
          ))}
        </div>

        <input
          class="search-input"
          type="search"
          placeholder="Buscar SAA-C03, AZ-104, security, architect..."
          aria-label="Buscar certificaciones"
          data-cert-search
        />
      </div>

      <div class="cert-grid">
        {certifications.map((cert) => (
          <article
            class="cert-card"
            data-cert-card
            data-provider={cert.provider}
            data-area={cert.area}
            data-search={`${cert.code ?? ''} ${cert.name} ${cert.provider} ${cert.area} ${cert.role} ${cert.focus}`.toLowerCase()}
            hidden={cert.provider !== defaultProvider}
          >
            <div class="cert-topline">
              <span class="exam-code">{cert.code ?? cert.level}</span>
              <span
                class:list={{
                  'status-chip': true,
                  active: cert.status === 'Vigente',
                  beta: cert.status === 'Beta',
                  retiring: cert.status === 'Próximo retiro'
                }}
              >
                {cert.status}
              </span>
            </div>

            <div class="cert-labels">
              <span class="provider-chip">{cert.provider}</span>
              <span>{cert.area} · {cert.level}</span>
            </div>

            <h3>{cert.name}</h3>
            <p>{cert.focus}</p>

            <dl class="cert-facts">
              <div><dt>Perfil</dt><dd>{cert.role}</dd></div>
              {cert.retirement && <div><dt>Retiro</dt><dd>{cert.retirement}</dd></div>}
            </dl>

            {cert.note && <div class="cert-note">{cert.note}</div>}

            <a class="cert-link" href={cert.url} target="_blank" rel="noopener noreferrer">
              Ver certificación oficial ↗
            </a>
          </article>
        ))}
      </div>

      <div class="empty-state" data-cert-empty hidden>
        No encontramos certificaciones con esos criterios.
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container transition-layout">
      <div>
        <span class="eyebrow">Cambios y transiciones</span>
        <h2>Lo que debes vigilar</h2>
        <p>
          Esta parte del mapa reúne retiros, nuevas versiones y cambios que pueden afectar
          una ruta de estudio durante 2026.
        </p>
      </div>

      <div>
        {providers.map((provider) => (
          <div
            class="transition-list"
            data-provider-transitions={provider}
            hidden={provider !== defaultProvider}
          >
            {transitions.filter((item) => item.provider === provider).map((item) => (
              <article>
                <strong>{item.code}</strong>
                <span>{item.title}</span>
                <em>{item.detail}</em>
              </article>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container official-sources">
      <span class="eyebrow">Fuente de verdad</span>
      <h2>Documentación oficial</h2>
      <p>
        Investigación revisada el <strong>14 de agosto de 2026</strong>. PatronTech enlaza
        directamente a Microsoft Learn, AWS Training & Certification y Google Cloud Learn.
      </p>

      {providers.map((provider) => (
        <div
          class="source-provider-group"
          data-provider-sources={provider}
          hidden={provider !== defaultProvider}
        >
          <h3>{provider}</h3>
          <div class="source-grid">
            {officialSources.filter((source) => source.provider === provider).map((source) => (
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                <strong>{source.title}</strong>
                <span>{source.description}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <script>
    const providerButtons = Array.from(document.querySelectorAll('[data-provider-filter]'));
    const cards = Array.from(document.querySelectorAll('[data-cert-card]'));
    const areaGroups = Array.from(document.querySelectorAll('[data-area-group]'));
    const routeGroups = Array.from(document.querySelectorAll('[data-provider-routes]'));
    const transitionGroups = Array.from(document.querySelectorAll('[data-provider-transitions]'));
    const sourceGroups = Array.from(document.querySelectorAll('[data-provider-sources]'));
    const providerNotes = Array.from(document.querySelectorAll('[data-provider-note]'));
    const search = document.querySelector('[data-cert-search]');
    const empty = document.querySelector('[data-cert-empty]');

    let activeProvider = 'Microsoft';
    let activeArea = 'Todos';

    const syncProviderUI = () => {
      providerButtons.forEach((button) => {
        const provider = button.getAttribute('data-provider-filter');
        button.classList.toggle('active', provider === activeProvider);
      });

      areaGroups.forEach((group) => {
        if (!(group instanceof HTMLElement)) return;
        group.hidden = group.dataset.areaGroup !== activeProvider;
      });

      routeGroups.forEach((group) => {
        if (!(group instanceof HTMLElement)) return;
        group.hidden = group.dataset.providerRoutes !== activeProvider;
      });

      transitionGroups.forEach((group) => {
        if (!(group instanceof HTMLElement)) return;
        group.hidden = group.dataset.providerTransitions !== activeProvider;
      });

      sourceGroups.forEach((group) => {
        if (!(group instanceof HTMLElement)) return;
        group.hidden = group.dataset.providerSources !== activeProvider;
      });

      providerNotes.forEach((note) => {
        if (!(note instanceof HTMLElement)) return;
        note.hidden = note.dataset.providerNote !== activeProvider;
      });

      document.querySelectorAll('[data-area-filter]').forEach((button) => {
        const provider = button.getAttribute('data-area-provider');
        const area = button.getAttribute('data-area-filter');
        button.classList.toggle(
          'active',
          provider === activeProvider && area === activeArea
        );
      });
    };

    const applyFilters = () => {
      const term = search instanceof HTMLInputElement
        ? search.value.trim().toLowerCase()
        : '';

      let visible = 0;

      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;

        const providerMatch = card.dataset.provider === activeProvider;
        const areaMatch = activeArea === 'Todos' || card.dataset.area === activeArea;
        const searchMatch = !term || (card.dataset.search ?? '').includes(term);
        const show = providerMatch && areaMatch && searchMatch;

        card.hidden = !show;
        if (show) visible += 1;
      });

      if (empty instanceof HTMLElement) {
        empty.hidden = visible !== 0;
      }
    };

    providerButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeProvider = button.getAttribute('data-provider-filter') ?? 'Microsoft';
        activeArea = 'Todos';
        syncProviderUI();
        applyFilters();
      });
    });

    document.querySelectorAll('[data-area-filter]').forEach((button) => {
      button.addEventListener('click', () => {
        if (button.getAttribute('data-area-provider') !== activeProvider) return;
        activeArea = button.getAttribute('data-area-filter') ?? 'Todos';
        syncProviderUI();
        applyFilters();
      });
    });

    search?.addEventListener('input', applyFilters);

    syncProviderUI();
    applyFilters();
  </script>
</BaseLayout>

<style>
  .provider-summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    max-width: 950px;
    margin-top: 28px;
  }

  .provider-summary-card {
    text-align: left;
    padding: 20px;
    color: inherit;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    cursor: pointer;
    transition: transform .2s ease, border-color .2s ease, background .2s ease;
  }

  .provider-summary-card:hover,
  .provider-summary-card.active {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--primary) 55%, var(--border));
    background: color-mix(in srgb, var(--primary) 7%, var(--surface));
  }

  .provider-kicker {
    display: block;
    font-weight: 800;
    margin-bottom: 12px;
  }

  .provider-summary-card strong {
    display: block;
    font: 700 2.25rem/1 "STIX Two Text", Georgia, serif;
    color: var(--primary-2);
  }

  .provider-summary-card small {
    display: block;
    margin-top: 8px;
    color: var(--muted);
    line-height: 1.35;
  }

  .cert-disclaimer {
    max-width: 950px;
    margin-top: 22px;
    padding: 14px 16px;
    border-left: 3px solid var(--primary);
    border-radius: 0 12px 12px 0;
    background: var(--surface-2);
    color: var(--muted);
    font-size: .92rem;
  }

  .provider-nav-section {
    padding-top: 30px;
    padding-bottom: 30px;
  }

  .provider-tabs {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .provider-tab {
    padding: 11px 18px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-weight: 800;
    cursor: pointer;
  }

  .provider-tab.active {
    color: var(--text);
    border-color: var(--primary);
    background: color-mix(in srgb, var(--primary) 12%, var(--surface));
  }

  .provider-note {
    max-width: 900px;
    margin: 16px 0 0;
    color: var(--muted);
  }

  .provider-note[hidden],
  .path-grid[hidden],
  .filter-row[hidden],
  .transition-list[hidden],
  .source-provider-group[hidden] {
    display: none !important;
  }

  .path-grid,
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .path-card,
  .cert-card,
  .transition-list article,
  .source-grid a {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
  }

  .path-card,
  .cert-card {
    padding: 22px;
  }

  .route-provider {
    display: inline-block;
    color: var(--primary-2);
    font-size: .75rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .path-card h3,
  .cert-card h3,
  .official-sources h2,
  .transition-layout h2 {
    font-family: "STIX Two Text", Georgia, serif;
  }

  .path-card h3 {
    margin: 9px 0 14px;
    font-size: 1.3rem;
    line-height: 1.2;
  }

  .path-card p,
  .cert-card > p,
  .official-sources > p,
  .transition-layout p {
    color: var(--muted);
  }

  .path-flow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
  }

  .path-flow span {
    font-family: "IBM Plex Mono", monospace;
    font-weight: 700;
    font-size: .8rem;
    padding: 7px 9px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--surface-2);
  }

  .path-flow b {
    color: var(--primary-2);
  }

  .cert-toolbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 26px;
  }

  .area-filter-shell {
    min-width: 0;
    flex: 1;
  }

  .cert-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .cert-card[hidden] {
    display: none !important;
  }

  .cert-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .exam-code {
    max-width: 70%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: "IBM Plex Mono", monospace;
    font-weight: 700;
    color: var(--primary-2);
    padding: 6px 9px;
    border-radius: 9px;
    background: var(--surface-2);
  }

  .status-chip {
    flex: 0 0 auto;
    padding: 5px 9px;
    border-radius: 999px;
    font-size: .72rem;
    font-weight: 800;
    border: 1px solid var(--border);
  }

  .status-chip.active { color: #22c55e; }
  .status-chip.beta { color: var(--violet); }
  .status-chip.retiring { color: #f59e0b; }

  .cert-labels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    color: var(--muted);
    font-size: .78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .provider-chip {
    padding: 4px 7px;
    border-radius: 7px;
    background: color-mix(in srgb, var(--primary) 11%, var(--surface-2));
    color: var(--primary-2);
  }

  .cert-card h3 {
    margin: 9px 0 10px;
    font-size: 1.32rem;
    line-height: 1.18;
  }

  .cert-card > p {
    flex: 1;
  }

  .cert-facts {
    display: grid;
    gap: 8px;
    margin: 0 0 16px;
  }

  .cert-facts div {
    display: grid;
    grid-template-columns: 74px 1fr;
    gap: 10px;
    font-size: .87rem;
  }

  .cert-facts dt {
    font-weight: 800;
    color: var(--muted);
  }

  .cert-facts dd {
    margin: 0;
  }

  .cert-note {
    margin-bottom: 16px;
    padding: 12px;
    border-radius: 10px;
    background: var(--surface-2);
    color: var(--muted);
    font-size: .84rem;
  }

  .cert-link {
    margin-top: auto;
    color: var(--primary-2);
    font-weight: 800;
  }

  .transition-layout {
    display: grid;
    grid-template-columns: .75fr 1.25fr;
    gap: 42px;
  }

  .transition-layout h2,
  .official-sources h2 {
    margin: 8px 0 12px;
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  .transition-list {
    display: grid;
    gap: 10px;
  }

  .transition-list article {
    display: grid;
    grid-template-columns: 120px minmax(0, .9fr) minmax(180px, 1.1fr);
    gap: 14px;
    align-items: center;
    padding: 16px;
  }

  .transition-list strong {
    font-family: "IBM Plex Mono", monospace;
    color: var(--primary-2);
  }

  .transition-list span {
    font-weight: 700;
  }

  .transition-list em {
    color: #f59e0b;
    font-size: .84rem;
    font-style: normal;
  }

  .source-provider-group {
    margin-top: 24px;
  }

  .source-provider-group > h3 {
    margin-bottom: 14px;
    font-size: 1.15rem;
  }

  .source-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .source-grid a {
    display: block;
    padding: 18px;
  }

  .source-grid a:hover {
    border-color: color-mix(in srgb, var(--primary) 50%, var(--border));
  }

  .source-grid strong,
  .source-grid span {
    display: block;
  }

  .source-grid span {
    margin-top: 5px;
    color: var(--muted);
    font-size: .9rem;
  }

  @media (max-width: 980px) {
    .provider-summary,
    .path-grid,
    .cert-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cert-toolbar {
      flex-direction: column;
      align-items: stretch;
    }

    .search-input {
      width: 100%;
    }

    .transition-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .provider-summary,
    .path-grid,
    .cert-grid,
    .source-grid {
      grid-template-columns: 1fr;
    }

    .provider-summary-card {
      width: 100%;
    }

    .transition-list article {
      grid-template-columns: 1fr;
      gap: 5px;
    }
  }
</style>
