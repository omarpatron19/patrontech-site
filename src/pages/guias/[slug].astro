---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { readingMinutes } from '../../lib/content';
import { absoluteUrl, buildBreadcrumbJsonLd, buildContentJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const entries = await getCollection('guides', ({ data }) => !data.draft && data.reviewStatus === 'approved');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const canonicalPath = `/guias/${entry.id}/`;
const socialImage = await getImage({ src: entry.data.cover, width: 1200, height: 630, fit: 'cover', format: 'webp' });
const imageUrl = absoluteUrl(socialImage.src);
const structuredData = [
  buildContentJsonLd(entry, canonicalPath, imageUrl),
  buildBreadcrumbJsonLd([{ name: 'Inicio', path: '/' }, { name: 'Guías', path: '/guias/' }, { name: entry.data.title, path: canonicalPath }])
];
---
<ContentLayout title={entry.data.title} description={entry.data.description} summary={entry.data.summary} canonicalPath={canonicalPath} category={entry.data.category} tags={entry.data.tags} label={"Guía"} publishedAt={entry.data.publishedAt} updatedAt={entry.data.updatedAt} readMinutes={readingMinutes(entry.body)} author={entry.data.author} cover={entry.data.cover} coverAlt={entry.data.coverAlt} imageCredit={entry.data.imageCredit} ogImage={socialImage.src} headings={headings} structuredData={structuredData} level={entry.data.level} durationMinutes={entry.data.durationMinutes} prerequisites={entry.data.prerequisites}><Content /></ContentLayout>
