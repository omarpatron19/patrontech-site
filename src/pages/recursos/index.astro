---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { azureToolkit, resources } from '../../data/resources';
import { buildCollectionPageJsonLd } from '../../lib/seo';

const title = 'Azure Toolkit y recursos cloud | PatronTech';
const description = 'Herramientas, plantillas, checklists y recursos prácticos para arquitectura Azure, FinOps, networking, sizing, automatización y gobierno.';
const structuredData = buildCollectionPageJsonLd(title, description, '/recursos/');
---

<BaseLayout title={title} description={description} canonicalPath="/recursos/" structuredData={structuredData}>
  <section class="page-hero toolkit-hero">
    <div class="container">
      <span class="eyebrow">PatronTech Azure Toolkit</span>
      <h1>Herramientas que vale la pena tener a la mano</h1>
      <p>
        Una selección curada de utilidades que ayudan a diseñar, evaluar, optimizar y operar ambientes Microsoft Azure.
        No es solo una lista de enlaces: cada recurso está organizado por el problema que ayuda a resolver.
      </p>
      <div class="hero-actions">
        <a class="primary-btn" href="#azure-toolkit">Explorar herramientas</a>
        <a class="secondary-btn" href="/articulos/4-herramientas-azure-profesionales/">Leer la guía</a>
      </div>
    </div>
  </section>

  <section class="section" id="azure-toolkit">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Azure Toolkit · Colección 01</span>
          <h2>4 recursos para el trabajo diario con Azure</h2>
          <p>Compute, FinOps, networking y assessment en una sola colección.</p>
        </div>
      </div>

      <div class="toolkit-grid">
        {azureToolkit.map((tool, index) => (
          <article class="tool-card">
            <div class="tool-card-top">
              <span class="tool-number">0{index + 1}</span>
              <span class="badge">{tool.kind}</span>
            </div>
            <p class="tool-category">{tool.category}</p>
            <h3>{tool.title}</h3>
            <p>{tool.description}</p>
            <div class="tool-tags" aria-label={`Etiquetas de ${tool.title}`}>
              {tool.tags.map((tag) => <span>{tag}</span>)}
            </div>
            <div class="tool-footer">
              <small>{tool.source}</small>
              <a class="text-link" href={tool.url} target="_blank" rel="noreferrer">Abrir herramienta ↗</a>
            </div>
          </article>
        ))}
      </div>

      <aside class="architect-note">
        <div class="note-icon" aria-hidden="true">PT</div>
        <div>
          <strong>Consejo del arquitecto</strong>
          <p>
            Usa estas herramientas para acelerar el análisis, no para reemplazarlo. Precio, latencia o una recomendación de sizing
            deben validarse contra disponibilidad regional, arquitectura, seguridad, resiliencia, desempeño y contexto de negocio.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section alt">
    <div class="container guide-callout">
      <div>
        <span class="eyebrow">Guía PatronTech</span>
        <h2>¿Cómo combinar estas cuatro herramientas?</h2>
        <p>
          Revisa un flujo práctico para seleccionar una familia de VM, comparar alternativas de costo, validar regiones por latencia
          y documentar el ambiente con Azure Resource Inventory.
        </p>
      </div>
      <a class="primary-btn" href="/articulos/4-herramientas-azure-profesionales/">Ver guía completa</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">En preparación</span>
          <h2>Más recursos PatronTech</h2>
          <p>Plantillas y materiales propios que iremos incorporando a la biblioteca.</p>
        </div>
      </div>
      <div class="listing">
        {resources.map((resource) => (
          <article class="card">
            <span class="badge">{resource.kind}</span>
            <h3>{resource.title}</h3>
            <p>{resource.description}</p>
            <span class="resource-status">{resource.status}</span>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .toolkit-hero p { max-width: 790px; }
  .toolkit-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .tool-card { display: flex; flex-direction: column; min-height: 340px; padding: 26px; border: 1px solid var(--border); border-radius: 22px; background: var(--surface); box-shadow: 0 12px 36px rgba(15,23,42,.05); }
  .tool-card-top, .tool-footer { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .tool-number { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: .82rem; color: var(--muted); }
  .tool-category { margin: 24px 0 5px; color: var(--primary-2); font-size: .84rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
  .tool-card h3 { margin: 0 0 10px; font-family: "STIX Two Text", Georgia, serif; font-size: 1.65rem; line-height: 1.15; }
  .tool-card > p:not(.tool-category) { margin: 0; color: var(--muted); }
  .tool-tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0; }
  .tool-tags span { padding: 5px 9px; border: 1px solid var(--border); border-radius: 999px; background: var(--surface-2); color: var(--muted); font-size: .78rem; font-weight: 700; }
  .tool-footer { margin-top: auto; padding-top: 18px; border-top: 1px solid var(--border); }
  .tool-footer small { color: var(--muted); }
  .architect-note { display: grid; grid-template-columns: auto 1fr; gap: 18px; margin-top: 24px; padding: 22px; border: 1px solid color-mix(in srgb,var(--primary) 32%,var(--border)); border-radius: 18px; background: color-mix(in srgb,var(--primary) 6%,var(--surface)); }
  .architect-note p { margin: 5px 0 0; color: var(--muted); }
  .note-icon { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 12px; background: var(--primary); color: white; font-weight: 900; }
  .guide-callout { display: flex; align-items: center; justify-content: space-between; gap: 36px; }
  .guide-callout h2 { margin: 5px 0 10px; font-family: "STIX Two Text", Georgia, serif; font-size: clamp(2rem,4vw,3rem); letter-spacing: -.03em; }
  .guide-callout p { max-width: 760px; margin: 0; color: var(--muted); }
  @media (max-width: 760px) {
    .toolkit-grid { grid-template-columns: 1fr; }
    .tool-card { min-height: 0; }
    .tool-footer { align-items: flex-start; flex-direction: column; gap: 8px; }
    .architect-note { grid-template-columns: 1fr; }
    .guide-callout { align-items: flex-start; flex-direction: column; }
  }
</style>
